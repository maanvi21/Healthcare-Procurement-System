# Copy to .env and adjust as needed. docker-compose and every service read from this file.

# --- Postgres (shared instance, database-per-service) ---
POSTGRES_USER=medisource
POSTGRES_PASSWORD=medisource_dev_pw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=medisource_minio
MINIO_SECRET_KEY=medisource_minio_secret
MINIO_SECURE=false
MINIO_CONSOLE_PORT=9001

# --- LLM (Groq) — powers document classification, field extraction and fraud screening ---
# Get a key at https://console.groq.com. Leave blank to run fully offline: the document
# service falls back to its rule-based classifier/extractor and still works end to end.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_ENABLED=true

# --- OPA ---
OPA_URL=http://opa:8181

# --- Temporal ---
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=approval-workflow-queue

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- OpenSign (self-hosted e-signature; point at your OpenSign instance) ---
OPENSIGN_BASE_URL=http://opensign:8080
OPENSIGN_API_KEY=changeme

# --- Notification agent (leave blank to use safe logging stubs) ---
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=your-verified-sender@example.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/here
TEAMS_WEBHOOK_URL=https://your-tenant.webhook.office.com/webhookb2/your-webhook-here
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567

# --- Service ports (host side) ---
DOCUMENT_SERVICE_PORT=8001
VENDOR_SERVICE_PORT=8002
APPROVAL_SERVICE_PORT=8003
INVENTORY_SERVICE_PORT=8004
CONTRACT_SERVICE_PORT=8005
RISK_SERVICE_PORT=8006
GATEWAY_PORT=80
FRONTEND_DEV_PORT=3000
