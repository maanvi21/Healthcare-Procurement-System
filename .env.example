# Copy to .env and adjust as needed. docker-compose and every service read from this file.

# --- Postgres (shared instance, database-per-service) ---
POSTGRES_USER=medisource
POSTGRES_PASSWORD=medisource_dev_pw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_CONSOLE_PORT=9001

# --- LLM (Groq) — powers document classification, field extraction and fraud screening ---
# Get a key at https://console.groq.com. Leave blank to run fully offline: the document
# service falls back to its rule-based classifier/extractor and still works end to end.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_ENABLED=true

# --- OPA ---
OPA_URL=http://opa:8181

# --- Temporal ---
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=approval-workflow-queue

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- DocuSign eSignature (free developer/demo account) ---
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_RSA_PRIVATE_KEY=
DOCUSIGN_OAUTH_HOST=account-d.docusign.com
# Leave blank to discover the REST base URL from DocuSign userinfo.
DOCUSIGN_REST_BASE_URL=
# Public HTTPS URL, e.g. https://your-host/api/contracts/webhooks/docusign
DOCUSIGN_CONNECT_URL=
DOCUSIGN_CONNECT_HMAC_KEY=
APPROVER_EMAILS={"department_manager":"dr.sarah@medisource.ai","finance_manager":"mark.finance@medisource.ai","compliance_officer":"elena.compliance@medisource.ai","procurement_director":"arthur.procurement@medisource.ai"}
USER_EMAILS={"Dr. Sarah":"dr.sarah@medisource.ai","Mark":"mark.finance@medisource.ai","Elena":"elena.compliance@medisource.ai","Arthur":"arthur.procurement@medisource.ai"}

# --- Notification agent (set a real internal fallback mailbox for all events) ---
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=your-verified-sender@example.com
DEFAULT_NOTIFICATION_RECIPIENT=

# Lets approval_workflow resolve a vendor's risk band for OPA routing.
RISK_INTELLIGENCE_URL=http://risk_intelligence:8000

# --- Service ports (host side) ---
DOCUMENT_SERVICE_PORT=8001
VENDOR_SERVICE_PORT=8002
APPROVAL_SERVICE_PORT=8003
INVENTORY_SERVICE_PORT=8004
CONTRACT_SERVICE_PORT=8005
RISK_SERVICE_PORT=8006
GATEWAY_PORT=80
FRONTEND_DEV_PORT=3000
